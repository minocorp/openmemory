#!/bin/bash
set -uo pipefail
. /usr/local/bin/memory-lib

readonly RESULT=/backup/state/restore-test.json
readonly PORT=5499
repo=1
if [ -n "${MEMORY_BACKUP_S3_BUCKET:-}" ]; then repo=2; fi
if [ "${1:-}" = --repo ]; then repo=$2; fi

exec 9>/backup/state/restore-test.lock
flock 9

scratch=$(mktemp -d /tmp/restore-test.XXXXXX)
detail=""

record() {
  local ok=$1
  mkdir -p "$(dirname "$RESULT")"
  jq -n --argjson ok "$ok" --argjson repo "$repo" --arg detail "$detail" \
    '{at: (now | floor | todate), ok: $ok, repo: $repo, detail: $detail}' >"$RESULT.tmp" &&
    mv "$RESULT.tmp" "$RESULT"
}

finish() {
  pg_ctl -D "$scratch" -m immediate stop >/dev/null 2>&1
  rm -rf "$scratch"
}
trap finish EXIT

fail() {
  detail=$1
  log "restore test failed: $detail"
  record false
  exit 1
}

restored_psql() {
  psql -h "$scratch" -p "$PORT" -Atc "$1"
}

before=$(psql -Atc "SELECT count(*) FROM pages") || fail "live database has no pages table"
pgbackrest check || fail "archive check failed"
pgbackrest --repo="$repo" --pg1-path="$scratch" restore ||
  fail "restore from repo $repo failed"
pg_ctl -D "$scratch" -w -t 120 -l "$scratch/restore-test.log" \
  -o "-c port=$PORT -c listen_addresses= -c unix_socket_directories=$scratch -c archive_mode=off" start ||
  fail "restored cluster did not start"
for _ in $(seq 120); do
  [ "$(restored_psql 'SELECT pg_is_in_recovery()' 2>/dev/null)" = f ] && break
  sleep 2
done
restored=$(restored_psql "SELECT count(*) FROM pages") || fail "restored cluster has no pages table"
after=$(psql -Atc "SELECT count(*) FROM pages")
if [ "$restored" -lt "$before" ] || [ "$restored" -gt "$after" ]; then
  fail "restored $restored pages, expected between $before and $after"
fi
if blobs_are_local; then
  restic_select "$repo"
  restic_do check --quiet || fail "blob repository check failed on repo $repo"
fi
detail="restored $restored pages from repo $repo"
log "restore test passed: $detail"
record true
