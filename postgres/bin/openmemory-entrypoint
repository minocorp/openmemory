#!/bin/sh
set -eu

if [ -n "${OPENMEMORY_BACKUP_PASSPHRASE:-}" ]; then
  retention=${OPENMEMORY_BACKUP_RETENTION_DAYS:-14}
  conf=/etc/pgbackrest/pgbackrest.conf

  old_umask=$(umask)
  umask 077
  {
    echo "[global]"
    echo "start-fast=y"
    echo "log-path=/var/log/pgbackrest"
    echo "repo1-path=/backup/pgbackrest"
    echo "repo1-retention-full-type=time"
    echo "repo1-retention-full=$retention"
    echo "repo1-cipher-type=aes-256-cbc"
    echo "repo1-cipher-pass=$OPENMEMORY_BACKUP_PASSPHRASE"
    if [ -n "${OPENMEMORY_BACKUP_S3_BUCKET:-}" ]; then
      endpoint=${OPENMEMORY_BACKUP_S3_ENDPOINT#https://}
      endpoint=${endpoint%/}
      echo "repo2-type=s3"
      echo "repo2-path=/pgbackrest"
      echo "repo2-s3-bucket=$OPENMEMORY_BACKUP_S3_BUCKET"
      echo "repo2-s3-endpoint=${endpoint%%:*}"
      case $endpoint in *:*) echo "repo2-storage-port=${endpoint##*:}" ;; esac
      echo "repo2-s3-region=${OPENMEMORY_BACKUP_S3_REGION:-us-east-1}"
      echo "repo2-s3-uri-style=${OPENMEMORY_BACKUP_S3_URI_STYLE:-host}"
      echo "repo2-s3-key=$OPENMEMORY_BACKUP_S3_ACCESS_KEY"
      echo "repo2-s3-key-secret=$OPENMEMORY_BACKUP_S3_SECRET_KEY"
      echo "repo2-retention-full-type=time"
      echo "repo2-retention-full=$retention"
      echo "repo2-cipher-type=aes-256-cbc"
      echo "repo2-cipher-pass=$OPENMEMORY_BACKUP_PASSPHRASE"
    fi
    echo "[openmemory]"
    echo "pg1-path=/var/lib/postgresql/data"
    echo "pg1-socket-path=/var/run/postgresql"
    echo "pg1-user=openmemory"
    echo "pg1-database=openmemory"
  } >"$conf"
  umask "$old_umask"
  if [ "$(id -u)" = 0 ]; then
    chown postgres:postgres "$conf"
  fi
fi

exec docker-entrypoint.sh "$@"
