{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n          i.id AS \"id: InviteId\",\n          u.username AS inviter,\n          u.display_name AS inviter_display_name,\n          i.created_at,\n          i.expires_at\n        FROM invites AS i\n        JOIN users AS u ON u.id = i.inviter_id\n        WHERE i.used_at IS NULL\n          AND i.expires_at > now()\n        ORDER BY i.created_at DESC, i.id DESC\n        ",
