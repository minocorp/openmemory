  "query": "\n        SELECT\n          id,\n          connection_id AS \"connection_id: ConnectionId\",\n          oauth_client_id AS \"oauth_client_id: OauthClientId\",\n          rotated_at IS NOT NULL AS \"is_rotated!\",\n          refresh_expires_at <= now() AS \"is_expired!\"\n        FROM oauth_tokens\n        WHERE refresh_token_hash = $1\n        FOR UPDATE\n        ",
