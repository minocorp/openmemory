{
  "db_name": "PostgreSQL",
  "query": "SELECT\n  f.id AS \"id: FileId\",\n  f.path,\n  f.sha256,\n  f.mime,\n  f.size,\n  f.user_id AS \"user_id: UserId\",\n  f.created_at,\n  (SELECT count(*) FROM file_pages AS p WHERE p.file_id = f.id) AS \"page_count!\"\nFROM files AS f\nWHERE f.deleted_at IS NULL\n  AND ($1 OR f.path = ANY($2) OR f.path LIKE ANY($3))\nORDER BY f.path",
