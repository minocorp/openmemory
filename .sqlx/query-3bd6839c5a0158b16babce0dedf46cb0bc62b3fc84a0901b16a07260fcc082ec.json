  "query": "\n        UPDATE oauth_codes\n        SET used_at = now()\n        WHERE code_hash = $1\n          AND used_at IS NULL\n        RETURNING\n          oauth_client_id AS \"oauth_client_id: OauthClientId\",\n          connection_id AS \"connection_id: ConnectionId\",\n          redirect_uri,\n          code_challenge,\n          expires_at <= now() AS \"is_expired!\"\n        ",
